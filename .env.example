OPENAI_API_KEY=sk-xxxxxx

# DB 接続先
DATABASE_URL=sqlite:///C:/Users/Kirua/Documents/NoLook/nolook_dev.db

# 感情分類の動作モード
NOLOOK_MANUAL_ONLY=0        # 1=完全手動, 0=自動＋LLM
NOLOOK_LLM_WEIGHT=0.6       # LLMの比率（0..1）

# APIキー（FastAPI側の認証用。未設定なら認証なし）
API_KEY=

# レート制限（1分あたりの許容回数、IP×パス単位）
NOLOOK_RATE_LIMIT_PER_MIN=60

# CORS許可（フロントのURL）
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 週報キャッシュTTL（秒）
WEEKLY_TTL_SECONDS=60

# VSCode用：Pythonパス解決
PYTHONPATH=${workspaceFolder}

DEBUG_LLM=0

NOLOOK_LLM_MODEL=gpt-4o-mini
